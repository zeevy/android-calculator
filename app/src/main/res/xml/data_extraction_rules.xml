<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules (the app's minimum is Android 12, which reads only this
  file). The app stores settings and per-tool choices (DataStore), history
  and unit pairs (Room) and up to three recent tool ids (SharedPreferences;
  health tools are never saved there). None of it is sensitive, so both
  cloud backup and device-to-device transfer include all of it.

  See: https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
